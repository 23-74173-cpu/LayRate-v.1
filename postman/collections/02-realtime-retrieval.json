{
  "info": {
    "name": "LayRate 02 - Real-Time Data Retrieval per Cage",
    "description": "Table IX API suite 2/6 (operator web session; login handled once in the collection pre-request, not counted as a case). Unauthenticated check is ordered LAST (it clears the cookie jar).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "loginRole",
      "value": "admin"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (/unauthenticated/i.test(pm.info.requestName)) {",
          "    // guest probe: no session, no login",
          "} else {",
          "    var base = pm.variables.get('baseUrl');",
          "    pm.sendRequest(base + '/login', function (err, res) {",
          "        var m = res.text().match(/name=\"_token\" value=\"([^\"]+)\"/);",
          "        var token = m && m[1];",
          "        pm.collectionVariables.set('csrf', token);",
          "        pm.sendRequest({",
          "            url: base + '/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "            body: { mode: 'urlencoded', urlencoded: [",
          "                { key: '_token', value: token },",
          "                { key: 'email', value: pm.variables.get(pm.variables.get('loginRole') + 'Email') },",
          "                { key: 'password', value: pm.variables.get(pm.variables.get('loginRole') + 'Password') }",
          "            ]}",
          "        }, function () { pm.collectionVariables.set('authed', '1'); });",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "TC-API-10 unauthenticated live-data redirects to login",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/environment/live-data?range=24h",
        "protocolProfileBehavior": {
          "followRedirects": false
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('lands on login page after redirect', function () { pm.response.to.have.status(200); });",
              "var html = pm.response.text();",
              "pm.test('shows sign-in, not protected content', function () {",
              "    pm.expect(html).to.contain('Sign in');",
              "    pm.expect(html).to.not.contain('environment-live-data');",
              "});",
              "pm.test('protected content absent', function () {\n    pm.expect(html).to.not.contain('environment-live-data');\n});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-API-06 live-data 24h returns frame with trend markers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/environment/live-data?range=24h"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('frame and trend markers present', function () {",
              "    pm.expect(pm.response.text()).to.contain('environment-live-data');",
              "    pm.expect(pm.response.text()).to.contain('TEMPERATURE TREND');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-API-07 live-data week range returns frame",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/environment/live-data?range=week"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('frame marker present', function () {",
              "    pm.expect(pm.response.text()).to.contain('environment-live-data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-API-08 invalid range falls back gracefully",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/environment/live-data?range=bogus"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 (default window, no 500)', function () { pm.response.to.have.status(200); });",
              "pm.test('frame marker present', function () {",
              "    pm.expect(pm.response.text()).to.contain('environment-live-data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-API-09 cage sensor-info returns JSON inventory",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/cages/{{cageId}}/sensor-info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('dht22 and spare keys present', function () {",
              "    pm.expect(body).to.have.property('dht22');",
              "    pm.expect(body).to.have.property('spare');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}